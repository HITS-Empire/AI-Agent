# Скопируй в .env и заполни. .env в git не попадает. Ключи генерируй: openssl rand -hex 32

# --- LLM-шлюз (LiteLLM) ---
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me
# Виртуальный ключ приложения (создаётся через /key/generate с бюджетом), НЕ master key
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=
# Без подписки ChatGPT (разработка, CI): BURMALDA_MODEL_MAIN=burmalda-mock
BURMALDA_MODEL_MAIN=burmalda-main
BURMALDA_MODEL_FAST=burmalda-fast
BURMALDA_MODEL_EMBED=burmalda-embed
# Окно контекста основной модели и порог compaction (доля окна)
BURMALDA_CONTEXT_WINDOW=200000
BURMALDA_COMPACT_AT=0.7

# Резервные провайдеры (платные, необязательные, по умолчанию пусто)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Хранилища ---
POSTGRES_USER=burmalda
POSTGRES_PASSWORD=burmalda
DATABASE_URL=postgresql://burmalda:burmalda@127.0.0.1:5432/burmalda
REDIS_URL=redis://127.0.0.1:6379

# --- Интерфейсы ---
TELEGRAM_BOT_TOKEN=
# Telegram user id владельца: боту отвечает только он
TELEGRAM_OWNER_ID=

# --- Песочница ---
SANDBOX_IMAGE=burmalda-sandbox:local
# sandbox | host. host = shell на машине (pwsh 7 / bash / zsh), только с подтверждением владельца
SHELL_MODE=sandbox
# Корень файловых инструментов и каталог, который монтируется в песочницу. `.` — сам репозиторий.
WORKSPACE_DIR=.

# --- Наблюдаемость ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006
OTEL_SERVICE_NAME=burmalda

# --- Навыки ---
GITHUB_TOKEN=
# Внешний календарь (только чтение): intime — расписание ТГУ, ics — любой iCal-фид (запасной вариант)
EXTERNAL_CALENDAR_SOURCE=intime
INTIME_BASE_URL=https://intime.tsu.ru/api/web/v1
# id группы из GET /faculties/{facultyId}/groups. 972302 (по умолчанию) и 972303 — НОЦ «Высшая ИТ школа»
INTIME_GROUP_ID=ac6b8bef-2c83-11ee-8151-005056bc52bb
# 972303: b344e210-2c83-11ee-8151-005056bc52bb
EXTERNAL_CALENDAR_ICS_URL=

# Поиск: SearXNG из docker-compose (JSON). Только localhost.
SEARXNG_URL=http://127.0.0.1:8080

# Личный календарь: Radicale из docker-compose (CalDAV)
CALDAV_URL=http://127.0.0.1:5232/owner/personal/
CALDAV_USERNAME=owner
CALDAV_PASSWORD=

# Маркетплейсы (бонус): площадки для marketplace_search
MARKETPLACES=ozon,wildberries,yandex_market
# Сервис headless-браузера (docker-compose, сервис browser); пауза между страницами одного сайта
BROWSER_URL=http://127.0.0.1:3100
# BROWSER_PORT=3100
# BROWSER_MIN_INTERVAL_MS=10000

# Владелец и сессия: одна сессия на все каналы
# BURMALDA_OWNER_ID=owner
# MCP-серверы (GitHub и др.)
# MCP_CONFIG=config/mcp.json

# Образ шлюза, если docker.litellm.ai недоступен
# LITELLM_IMAGE=ghcr.io/berriai/litellm
# LITELLM_TAG=main-stable
# POSTGRES_PORT=5432
