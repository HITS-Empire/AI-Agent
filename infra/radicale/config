# Radicale — свой CalDAV-сервер для личного календаря «бурмалды».
# Слушает только 127.0.0.1 на хосте (см. docker-compose.yml), поэтому вход упрощён:
# htpasswd с plain-паролем из ./.secrets/radicale/users (файл создаётся по README, в git не попадает).
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /secrets/users
htpasswd_encryption = plain

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections
